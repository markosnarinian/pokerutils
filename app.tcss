#main {
    height: 1fr;
}

Table {
    width: 1fr;
}

SidePanel {
    width: 45;
    border: round white;
    padding: 1;
}

CommunityCards {
    height: 1fr;
    align: center middle;
    border: round white;
}

#bottom {
    height: 1fr;
}

PlayerHand {
    align: center middle;
    border: round white;
}

AnswerPanel {
    border: round white;
}

PlayingCard {
    margin-left: 1;
}

PlayingCard:first-of-type {
    margin-left: 0;
}
