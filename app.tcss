#main {
    height: 1fr;
}

Table {
    width: 1fr;
}

SidePanel {
    width: 45;
    border: round white;
}

CommunityCards {
    height: 1fr;
    align: center middle;
    border: round white;
    padding: 1;
}

#bottom {
    height: 1fr;
}

PlayerHand {
    align: center middle;
    border: round white;
    padding: 1;
}

AnswerPanel {
    align: center middle;
    border: round white;
    padding: 1;
}

AnswerPanel HorizontalGroup {
    align: center middle;
    width: auto;
    margin-bottom: 1;
}

#odds-against {
    margin-left: 1;
}

#outs {
    margin-left: 9;
}

AnswerPanel Input {
    width: 15;
}

AnswerPanel Button {
    width: 29;
}

PlayingCard {
    margin-left: 1;
}

PlayingCard:first-of-type {
    margin-left: 0;
}
